# Copy to .env.local and fill in. Each Google Form's responses go to its linked Google Sheet.
# In the form: open the live form, "Get pre-filled link" to find entry.NNNN ids per question.
# URL = the form's /viewform link with "viewform" replaced by "formResponse".

# Stocking registration (/register)
GOOGLE_FORM_REGISTER_URL=https://docs.google.com/forms/d/e/FORM_ID/formResponse
GOOGLE_FORM_REGISTER_ENTRY_NAME=entry.1111111111
GOOGLE_FORM_REGISTER_ENTRY_EMAIL=entry.2222222222
GOOGLE_FORM_REGISTER_ENTRY_BLOCK=entry.3333333333
GOOGLE_FORM_REGISTER_ENTRY_ROOM=entry.4444444444
GOOGLE_FORM_REGISTER_ENTRY_NOTES=entry.5555555555

# Home-page RSVP popup (can be the same form or a second one)
GOOGLE_FORM_RSVP_URL=https://docs.google.com/forms/d/e/FORM_ID/formResponse
GOOGLE_FORM_RSVP_ENTRY_NAME=entry.1111111111
GOOGLE_FORM_RSVP_ENTRY_EMAIL=entry.2222222222
GOOGLE_FORM_RSVP_ENTRY_ATTENDING=entry.3333333333
